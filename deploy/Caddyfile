# Caddy obtains and renews the TLS certificate for ANYSSH_DOMAIN automatically.
# WebSocket upgrades (the terminal) are proxied without extra configuration.
{
	# "email <address>" for Let's Encrypt expiry notices, or nothing (compose.yaml builds it from ANYSSH_ACME_EMAIL).
	{$ANYSSH_CADDY_EMAIL}
}

{$ANYSSH_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}
