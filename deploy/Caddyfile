# Caddy obtains and renews the TLS certificate for ANYSSH_DOMAIN automatically.
# WebSocket upgrades (the terminal) are proxied without extra configuration.
{
	# Let's Encrypt expiry notices go here (optional).
	email {$ANYSSH_ACME_EMAIL}
}

{$ANYSSH_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}
