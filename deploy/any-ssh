#!/usr/bin/env bash
# Manage an Any-SSH server installed with deploy/install.sh. Run `any-ssh help` for the commands.
set -euo pipefail

DIR="${ANYSSH_DIR:-/opt/any-ssh}"
REF="${ANYSSH_REF:-main}"
SOURCE="${ANYSSH_SOURCE:-https://raw.githubusercontent.com/Maffewem/Any-SSH/${REF}}"
KEEP_BACKUPS="${ANYSSH_KEEP_BACKUPS:-14}"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: any-ssh <command>

  update        Back up, then download the latest version and restart (open terminals reconnect)
  backup        Save a copy of the database to $DIR/backups (keeps the newest $KEEP_BACKUPS)
  status        Show whether it is running and healthy
  logs          Follow the logs (Ctrl+C to stop)
  config        Edit the settings (.env), then apply them
  start         Start it
  stop          Stop it
  restart       Restart it (including the HTTPS proxy, which retries the certificate)
  doctor        Check the domain, DNS and HTTPS certificate, and explain what's wrong
  setup-token   Show the one-time token for creating the first admin
  version       Show the running version

Install directory: $DIR (set ANYSSH_DIR to change). Put your own Compose changes in
$DIR/compose.override.yaml; 'update' replaces compose.yaml.
EOF
}

[ -f "$DIR/compose.yaml" ] || die "No Any-SSH install found in $DIR."
cd "$DIR"
dc() { docker compose "$@"; }

need_root() { [ "$(id -u)" -eq 0 ] || die "Run it as root: sudo any-ssh $1"; }

wait_healthy() {
  local id status=""
  for _ in $(seq 1 60); do
    id="$(dc ps -q app 2>/dev/null || true)"
    if [ -n "$id" ]; then
      status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)"
      [ "$status" = healthy ] && return 0
    fi
    sleep 2
  done
  dc logs --tail 30 app >&2 || true
  die "Any-SSH did not become healthy (last status: ${status:-not running}). The logs above should say why."
}

domain() { sed -n "s/^ANYSSH_DOMAIN=//p" "$DIR/.env" | tr -d "'\"" | tail -n 1; }

# Public view of the domain (what Let's Encrypt and phones outside your network see), via DNS-over-HTTPS.
# Prints the A records, "none" when the name doesn't exist publicly, or nothing when the lookup itself failed.
public_a() {
  local url json
  for url in ${ANYSSH_DOH_URL:-https://cloudflare-dns.com/dns-query https://dns.google/resolve}; do
    json="$(curl -fsS --max-time 10 -H 'accept: application/dns-json' "$url?name=$1&type=A" 2>/dev/null)" || continue
    [[ "$json" == *'"Status"'* ]] || continue
    { grep -oE '"data": *"[0-9]+(\.[0-9]+){3}"' <<<"$json" || true; } | grep -oE '[0-9]+(\.[0-9]+){3}' |
      sort -u | paste -sd' ' - | grep . || echo none
    return
  done
}
public_ip() { curl -4fsS --max-time 10 "${ANYSSH_IP_URL:-https://api.ipify.org}" 2>/dev/null || true; }
local_a() { getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd' ' -; }

# Exit status 0 when DNS looks right. Prints what it found and what to do about it.
check_dns() {
  local d="$1" pub ip loc ok=0
  pub="$(public_a "$d" || true)"; ip="$(public_ip)"; loc="$(local_a "$d" || true)"
  printf '  %-26s %s\n' "Domain:" "$d"
  printf '  %-26s %s\n' "Public DNS (A record):" "${pub:-unknown (no public DNS resolver reachable)}"
  printf '  %-26s %s\n' "This server's public IP:" "${ip:-unknown}"
  [ -z "$loc" ] || [ -z "$pub" ] || [ "$loc" = "$pub" ] || printf '  %-26s %s\n' "Resolves on this network:" "$loc"
  if [ "$pub" = none ]; then
    ok=1
    echo
    echo "  $d has no public DNS record, so no certificate can be issued and browsers can't reach it from outside."
    local target="${ip:-the public IP address of this server}"
    echo "  Add an A record for it pointing at $target with your DNS provider."
  elif [ -n "$pub" ] && [ -n "$ip" ] && [[ " $pub " != *" $ip "* ]]; then
    ok=1
    echo
    echo "  $d points at $pub, but this server's public IP is $ip. Update the A record to $ip."
    echo "  (If the domain is on Cloudflare with the orange-cloud proxy on, set it to 'DNS only' instead.)"
  fi
  if [ -n "$ip" ] && ! ip -4 addr 2>/dev/null | grep -q "inet $ip/"; then
    echo
    echo "  This server is behind a router (NAT). If you haven't already, forward TCP ports 80 and 443 on the router to"
    echo "  this server ($(hostname -I 2>/dev/null | awk '{print $1}')). Without that, HTTPS can't be set up and the site isn't reachable from outside."
  fi
  return "$ok"
}

# Exit status 0 when Caddy is serving a certificate for the domain.
cert_ok() {
  echo | openssl s_client -connect 127.0.0.1:443 -servername "$1" 2>/dev/null | openssl x509 -noout >/dev/null 2>&1
}
cert_error() {
  dc logs --no-log-prefix caddy 2>/dev/null | grep '"could not get certificate' | tail -n 1 |
    sed -n 's/.*"error":"\([^"]*\)".*/\1/p'
}

doctor() {
  local d status=0 err
  d="$(domain)"
  [ -n "$d" ] || die "ANYSSH_DOMAIN isn't set in $DIR/.env."
  check_dns "$d" || status=1
  echo
  if cert_ok "$d"; then
    printf '  %-26s %s\n' "HTTPS certificate:" "OK"
  else
    status=1
    printf '  %-26s %s\n' "HTTPS certificate:" "not issued yet"
    err="$(cert_error || true)"
    [ -z "$err" ] || echo "  Last attempt failed with: $err"
    echo "  After fixing DNS or ports, run 'sudo any-ssh restart' to try again straight away."
  fi
  return "$status"
}

running() { [ -n "$(dc ps -q --status running app 2>/dev/null || true)" ]; }

backup() {
  running || { say "Not running, so there is nothing to back up"; return 0; }
  local name
  name="any-ssh-$(date -u +%Y%m%dT%H%M%SZ).db"
  dc exec -T app node dist/cli/backup.js "/data/backups/$name" >/dev/null
  install -d -m 700 "$DIR/backups"
  dc cp "app:/data/backups/$name" "$DIR/backups/$name" >/dev/null 2>&1 || die "Couldn't copy the backup out of the container."
  dc exec -T app rm -f "/data/backups/$name"
  chmod 600 "$DIR/backups/$name"
  # Keep the newest $KEEP_BACKUPS.
  find "$DIR/backups" -maxdepth 1 -name 'any-ssh-*.db' -printf '%f\n' | sort -r | tail -n +"$((KEEP_BACKUPS + 1))" |
    while read -r old; do rm -f "$DIR/backups/$old"; done
  say "Backup saved to $DIR/backups/$name"
  echo "    Copy backups off this server too. They need the master key to restore, so store them apart from it."
}

fetch() { curl -fsSL --proto '=https,file' "$SOURCE/$1" -o "$2"; }

case "${1:-help}" in
  start)
    need_root start
    dc up -d --pull missing
    wait_healthy
    say "Running"
    ;;
  stop) need_root stop; dc stop ;;
  restart)
    need_root restart
    dc up -d
    dc restart
    wait_healthy
    say "Restarted"
    ;;
  update)
    need_root update
    backup
    say "Downloading the latest version"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    fetch compose.yaml "$tmp/compose.yaml"
    fetch deploy/Caddyfile "$tmp/Caddyfile"
    fetch deploy/any-ssh "$tmp/any-ssh"
    install -m 644 "$tmp/compose.yaml" "$DIR/compose.yaml"
    install -m 644 "$tmp/Caddyfile" "$DIR/deploy/Caddyfile"
    dc pull --quiet || die "Couldn't download the new version. Check this server can reach ghcr.io, then try again."
    dc up -d --remove-orphans
    wait_healthy
    # Replaced last: install writes a new file, so this running copy is unaffected.
    install -m 755 "$tmp/any-ssh" /usr/local/bin/any-ssh
    docker image prune -f >/dev/null || true
    say "Updated and running"
    ;;
  backup) need_root backup; backup ;;
  status) dc ps ;;
  doctor) doctor ;;
  check-dns) check_dns "${2:-$(domain)}" ;;
  wait-cert)
    # Used by the installer: wait for the first certificate, then report.
    for _ in $(seq 1 "${2:-45}"); do cert_ok "$(domain)" && exit 0; sleep 2; done
    exit 1
    ;;
  logs) dc logs -f --tail 100 ;;
  config)
    need_root config
    "${EDITOR:-nano}" "$DIR/.env"
    chmod 600 "$DIR/.env"
    dc up -d
    wait_healthy
    say "Settings applied"
    ;;
  setup-token)
    needed="$(dc exec -T app node -e "fetch('http://127.0.0.1:8080/api/setup').then(r=>r.json()).then(j=>console.log(j.needed))" 2>/dev/null || true)"
    [ "$needed" = true ] || die "Setup is already done (or Any-SSH isn't running). Sign in with an admin account."
    token="$(dc logs --no-log-prefix app 2>/dev/null | sed -n 's/^.*Setup token: *\([^ ]*\).*$/\1/p' | tail -n 1)"
    [ -n "$token" ] || die "No setup token in the logs. It is only shown while no admin exists; restart to print a new one."
    echo "$token"
    ;;
  version)
    id="$(dc ps -q app 2>/dev/null || true)"
    [ -n "$id" ] || die "Not running."
    docker inspect -f '{{.Config.Image}}  version {{or (index .Config.Labels "org.opencontainers.image.version") "unknown"}}, commit {{or (index .Config.Labels "org.opencontainers.image.revision") "unknown"}}, built {{or (index .Config.Labels "org.opencontainers.image.created") "unknown"}}' "$id"
    ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
