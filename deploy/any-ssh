#!/usr/bin/env bash
# Manage an Any-SSH server installed with deploy/install.sh. Run `any-ssh help` for the commands.
set -euo pipefail

DIR="${ANYSSH_DIR:-/opt/any-ssh}"
REF="${ANYSSH_REF:-main}"
SOURCE="${ANYSSH_SOURCE:-https://raw.githubusercontent.com/Maffewem/Any-SSH/${REF}}"
KEEP_BACKUPS="${ANYSSH_KEEP_BACKUPS:-14}"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: any-ssh <command>

  update        Back up, then download the latest version and restart (open terminals reconnect).
                If the new version doesn't start, the previous one is put back
  update-log    Show the history of updates (also on the Settings page in the app)
  auto-update   on | off | status: install updates by itself, inside the maintenance window set in Settings
                (once a day, any time, if none is set). Off unless you turn it on
  web-update    on | off | status: let admins press "Update now" in the app. Starts the update agent
                (a timer that looks for requests every 5 minutes; the app itself never gets Docker access)
  backup        Save a copy of the database to $DIR/backups (keeps the newest $KEEP_BACKUPS). Encrypted once
                a recovery key is set in Settings. With --push, also store one at the destination set there
  backup-key    Make a new backup recovery key pair (keep the secret half offline, paste the public half in Settings)
  verify-backup <file> <secret-key-file>
                Decrypt a backup and check it is complete, without changing anything
  restore <file> <secret-key-file>
                Replace the database with one from a backup (after verifying it). Stops Any-SSH while it does
  status        Show whether it is running and healthy
  logs          Follow the logs (Ctrl+C to stop)
  config        Edit the settings (.env), then apply them
  start         Start it
  stop          Stop it
  restart       Restart it (including the HTTPS proxy, which retries the certificate)
  doctor        Check the domain, DNS and HTTPS certificate, and explain what's wrong
  setup-token   Show the one-time token for creating the first admin
  version       Show the running version

Install directory: $DIR (set ANYSSH_DIR to change). Put your own Compose changes in
$DIR/compose.override.yaml; 'update' replaces compose.yaml.
EOF
}

[ -f "$DIR/compose.yaml" ] || die "No Any-SSH install found in $DIR."
cd "$DIR"
dc() { docker compose "$@"; }

need_root() { [ "$(id -u)" -eq 0 ] || die "Run it as root: sudo any-ssh $1"; }

wait_healthy() {
  local id status=""
  for _ in $(seq 1 60); do
    id="$(dc ps -q app 2>/dev/null || true)"
    if [ -n "$id" ]; then
      status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)"
      [ "$status" = healthy ] && return 0
    fi
    sleep 2
  done
  dc logs --tail 30 app >&2 || true
  die "Any-SSH did not become healthy (last status: ${status:-not running}). The logs above should say why."
}

domain() { sed -n "s/^ANYSSH_DOMAIN=//p" "$DIR/.env" | tr -d "'\"" | tail -n 1; }

# Public view of the domain (what Let's Encrypt and phones outside your network see), via DNS-over-HTTPS.
# Prints the A records, "none" when the name doesn't exist publicly, or nothing when the lookup itself failed.
public_a() {
  local url json
  for url in ${ANYSSH_DOH_URL:-https://cloudflare-dns.com/dns-query https://dns.google/resolve}; do
    json="$(curl -fsS --max-time 10 -H 'accept: application/dns-json' "$url?name=$1&type=A" 2>/dev/null)" || continue
    [[ "$json" == *'"Status"'* ]] || continue
    { grep -oE '"data": *"[0-9]+(\.[0-9]+){3}"' <<<"$json" || true; } | grep -oE '[0-9]+(\.[0-9]+){3}' |
      sort -u | paste -sd' ' - | grep . || echo none
    return
  done
}
public_ip() { curl -4fsS --max-time 10 "${ANYSSH_IP_URL:-https://api.ipify.org}" 2>/dev/null || true; }
local_a() { getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd' ' -; }

# Exit status 0 when DNS looks right. Prints what it found and what to do about it.
check_dns() {
  local d="$1" pub ip loc ok=0
  pub="$(public_a "$d" || true)"; ip="$(public_ip)"; loc="$(local_a "$d" || true)"
  printf '  %-26s %s\n' "Domain:" "$d"
  printf '  %-26s %s\n' "Public DNS (A record):" "${pub:-unknown (no public DNS resolver reachable)}"
  printf '  %-26s %s\n' "This server's public IP:" "${ip:-unknown}"
  [ -z "$loc" ] || [ -z "$pub" ] || [ "$loc" = "$pub" ] || printf '  %-26s %s\n' "Resolves on this network:" "$loc"
  if [ "$pub" = none ]; then
    ok=1
    echo
    echo "  $d has no public DNS record, so no certificate can be issued and browsers can't reach it from outside."
    local target="${ip:-the public IP address of this server}"
    echo "  Add an A record for it pointing at $target with your DNS provider."
  elif [ -n "$pub" ] && [ -n "$ip" ] && [[ " $pub " != *" $ip "* ]]; then
    ok=1
    echo
    echo "  $d points at $pub, but this server's public IP is $ip. Update the A record to $ip."
    echo "  (If the domain is on Cloudflare with the orange-cloud proxy on, set it to 'DNS only' instead.)"
  fi
  if [ -n "$ip" ] && ! ip -4 addr 2>/dev/null | grep -q "inet $ip/"; then
    echo
    echo "  This server is behind a router (NAT). If you haven't already, forward TCP ports 80 and 443 on the router to"
    echo "  this server ($(hostname -I 2>/dev/null | awk '{print $1}')). Without that, HTTPS can't be set up and the site isn't reachable from outside."
  fi
  return "$ok"
}

# Exit status 0 when Caddy is serving a certificate for the domain.
cert_ok() {
  echo | openssl s_client -connect 127.0.0.1:443 -servername "$1" 2>/dev/null | openssl x509 -noout >/dev/null 2>&1
}
cert_error() {
  dc logs --no-log-prefix caddy 2>/dev/null | grep '"could not get certificate' | tail -n 1 |
    sed -n 's/.*"error":"\([^"]*\)".*/\1/p'
}

doctor() {
  local d status=0 err
  d="$(domain)"
  [ -n "$d" ] || die "ANYSSH_DOMAIN isn't set in $DIR/.env."
  check_dns "$d" || status=1
  echo
  if [ -z "$(dc ps -q --status running caddy 2>/dev/null || true)" ] || \
    [ "$(docker inspect -f '{{.State.Restarting}}' "$(dc ps -q caddy)" 2>/dev/null)" = true ]; then
    status=1
    echo "  The HTTPS proxy (Caddy) isn't running. Checking its configuration:"
    dc run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile 2>&1 |
      grep -iE '"level":"(error|fatal)"|^error|Valid configuration' | tail -n 2 | sed 's/^/    /' || true
    echo
  fi
  if cert_ok "$d"; then
    printf '  %-26s %s\n' "HTTPS certificate:" "OK"
  else
    status=1
    printf '  %-26s %s\n' "HTTPS certificate:" "not issued yet"
    err="$(cert_error || true)"
    [ -z "$err" ] || echo "  Last attempt failed with: $err"
    echo "  After fixing DNS or ports, run 'sudo any-ssh restart' to try again straight away."
  fi
  return "$status"
}

# Update history: one line in $DIR/update.log on the host, and one entry in the app's audit log (shown on the
# Settings page). Best effort, never stops an update. Holds versions and a short note, no secrets.
image_label() { docker image inspect -f '{{or (index .Config.Labels "org.opencontainers.image.version") "unknown"}} ({{printf "%.7s" (or (index .Config.Labels "org.opencontainers.image.revision") "unknown")}})' "$1" 2>/dev/null || echo unknown; }
record_update() {
  local result="$1" trigger="$2" from="$3" to="$4" note="${5:-}"
  install -d -m 700 "$DIR" 2>/dev/null || true
  printf '%s %s %s by %s: %s -> %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$result" "$trigger" "${SUDO_USER:-${USER:-root}}" "$from" "$to" "$note" >>"$DIR/update.log" 2>/dev/null || true
  chmod 600 "$DIR/update.log" 2>/dev/null || true
  dc exec -T app node dist/cli/record-update.js "$result" "$trigger" "$from" "$to" "$note" >/dev/null 2>&1 || true
}

running() { [ -n "$(dc ps -q --status running app 2>/dev/null || true)" ]; }

backup() {
  running || { say "Not running, so there is nothing to back up"; return 0; }
  local push=0 stamp path name
  if [ "${1:-}" = --push ]; then push=1; fi
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  # Encrypted (.anybak) when a recovery key is set in Settings → Backups, otherwise a plain copy (.db).
  path="$(dc exec -T app node dist/cli/backup.js file "/data/backups/any-ssh-$stamp")" || die "The backup failed. Run 'any-ssh logs' for details."
  name="$(basename "$path")"
  install -d -m 700 "$DIR/backups"
  dc cp "app:$path" "$DIR/backups/$name" >/dev/null 2>&1 || die "Couldn't copy the backup out of the container."
  dc exec -T app rm -f "$path"
  chmod 600 "$DIR/backups/$name"
  # Keep the newest $KEEP_BACKUPS.
  find "$DIR/backups" -maxdepth 1 \( -name 'any-ssh-*.db' -o -name 'any-ssh-*.anybak' \) -printf '%f\n' | sort -r | tail -n +"$((KEEP_BACKUPS + 1))" |
    while read -r old; do rm -f "$DIR/backups/$old"; done
  say "Backup saved to $DIR/backups/$name"
  case "$name" in
    *.db) echo "    Not encrypted: set a recovery key in Settings → Backups to encrypt backups, here and off this server." ;;
    *) echo "    Encrypted. Reading it needs the recovery secret key you saved, plus the master key to use what's inside." ;;
  esac
  if [ "$push" = 1 ]; then
    local rc=0
    dc exec -T app node dist/cli/backup.js run || rc=$?
    if [ "$rc" -eq 3 ]; then
      echo "    No off-server backup destination is configured (Settings → Backups)."
    elif [ "$rc" -ne 0 ]; then
      die "Storing the backup at the destination failed (see above)."
    fi
  fi
}

# Runs the backup tool in a throwaway container with the key in its environment (not on the command line, which other
# users could see) and the backup on standard input (the container's user cannot read root's files).
backup_tool() {
  local file="$1" key="$2"; shift 2
  [ -r "$file" ] || die "Can't read $file."
  [ -r "$key" ] || die "Can't read the secret key file $key."
  ANYSSH_BACKUP_KEY="$(cat "$key")" dc run --rm --no-deps -T -e ANYSSH_BACKUP_KEY app node dist/cli/backup.js restore - "$@" <"$file"
}

restore_backup() {
  local file="${1:-}" key="${2:-}"
  if [ -z "$file" ] || [ -z "$key" ]; then die "Usage: sudo any-ssh restore <backup file> <secret key file>"; fi
  say "Checking the backup first (nothing is changed yet)"
  backup_tool "$file" "$key" --verify-only || die "The backup didn't pass, so nothing was changed."
  echo
  echo "  This replaces the current database with the backup. Anything added since the backup is lost."
  echo "  The current database is kept next to it as any-ssh.db.before-restore-<time> inside the data volume."
  if [ "${ANYSSH_YES:-}" != 1 ]; then
    read -r -p "  Type 'restore' to go ahead: " answer </dev/tty || die "Run it from a terminal, or set ANYSSH_YES=1."
    [ "$answer" = restore ] || die "Cancelled. Nothing was changed."
  fi
  # A pre-restore copy of the live database, in case it turns out to be the wrong backup.
  if running; then backup; fi
  dc stop app
  backup_tool "$file" "$key" --force || die "The restore failed. The previous database is untouched. Start it again with: sudo any-ssh start"
  dc up -d
  wait_healthy
  say "Restored and running. Check the audit log under Admin to see the history up to the backup."
}

image_id() { docker inspect -f '{{.Image}}' "$(dc ps -q app 2>/dev/null | head -n 1)" 2>/dev/null || true; }
app_image() { dc config --images 2>/dev/null | grep -m1 'any-ssh:' || true; }

# Back up, pull the new image, restart, and put the old image back if the new one doesn't become healthy.
# update-if-newer (used by the timer) does nothing unless a newer image was published.
update_app() {
  local mode="$1" old_id new_id image tmp trigger=manual from to
  [ "$mode" = update-if-newer ] && trigger=auto
  trigger="${ANYSSH_TRIGGER:-$trigger}"
  tmp="$(mktemp -d)"
  # Expand now: the EXIT trap runs after this function returns, when the local $tmp is gone (set -u).
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  old_id="$(image_id)"
  from="$(image_label "$old_id")"
  image="$(app_image)"
  if [ "$mode" = update-if-newer ]; then
    dc pull --quiet app 2>/dev/null || { say "Couldn't reach the registry; will try again later"; return 0; }
    new_id="$(docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true)"
    if [ -n "$old_id" ] && [ "$old_id" = "$new_id" ]; then say "Already up to date"; return 0; fi
  fi
  backup
  say "Downloading the latest version"
  if ! dc pull --quiet; then
    record_update failure "$trigger" "$from" unknown "download failed"
    die "Couldn't download the new version. Check this server can reach ghcr.io, then try again."
  fi
  image="$(app_image)"
  to="$(image_label "$image")"
  # The deployment files come out of the new image (works even if the source repo is private); ANYSSH_SOURCE overrides.
  fetch compose.yaml "$tmp/compose.yaml" "$image"
  fetch deploy/Caddyfile "$tmp/Caddyfile" "$image"
  fetch deploy/any-ssh "$tmp/any-ssh" "$image"
  install -m 644 "$tmp/compose.yaml" "$DIR/compose.yaml"
  install -m 644 "$tmp/Caddyfile" "$DIR/deploy/Caddyfile"
  image="$(app_image)"
  dc up -d --remove-orphans
  if ! (wait_healthy); then
    if [ -n "$old_id" ]; then
      say "The new version didn't start. Putting the previous version back"
      docker tag "$old_id" "$image"
      dc up -d --no-deps app
      wait_healthy
      record_update rolled_back "$trigger" "$from" "$to" "new version did not become healthy; previous version restored"
      die "Rolled back to the previous version. The backup taken before this update is in $DIR/backups. Run 'any-ssh logs' to see why."
    fi
    record_update failure "$trigger" "$from" "$to" "new version did not become healthy; no previous version to restore"
    die "The new version didn't start and there was no previous image to go back to."
  fi
  # Replaced last: install writes a new file, so this running copy is unaffected.
  install -m 755 "$tmp/any-ssh" /usr/local/bin/any-ssh
  docker image prune -f >/dev/null || true
  record_update success "$trigger" "$from" "$to" "${ANYSSH_UPDATE_NOTE:-}"
  say "Updated and running"
}

# Update agent: a systemd timer that runs `any-ssh update-poll` every 5 minutes. It carries out "Update now" requests
# from the web app and, when automatic updates are on, applies updates inside the maintenance window. The web app
# never gets Docker access; it only records requests in its database, which this reads through `docker compose exec`.
env_flag() { sed -n "s/^$1=//p" "$DIR/.env" | tr -d "'\"" | tail -n 1; }
set_env_flag() { sed -i "/^$1=/d" "$DIR/.env"; [ -z "$2" ] || echo "$1=$2" >>"$DIR/.env"; }

agent_install() {
  local unit=/etc/systemd/system/any-ssh-update
  command -v systemctl >/dev/null || die "This needs systemd. With cron instead, run every 5 minutes: /usr/local/bin/any-ssh update-poll"
  cat >"$unit.service" <<UNIT
[Unit]
Description=Carry out Any-SSH update requests and scheduled updates
After=docker.service network-online.target
[Service]
Type=oneshot
Environment=ANYSSH_DIR=$DIR
ExecStart=/usr/local/bin/any-ssh update-poll
UNIT
  cat >"$unit.timer" <<UNIT
[Unit]
Description=Any-SSH update agent
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
  systemctl enable --now any-ssh-update.timer >/dev/null
}

agent_remove() {
  if command -v systemctl >/dev/null; then
    systemctl disable --now any-ssh-update.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/any-ssh-update.service /etc/systemd/system/any-ssh-update.timer
    systemctl daemon-reload
  fi
}

# One agent run. Asks the app what to do (it holds the requests and the maintenance window), then does it.
update_poll() {
  running || return 0
  local out action="" trigger="" by=""
  out="$(dc exec -T app node dist/cli/update-poll.js 2>/dev/null)" || return 0
  read -r action trigger by <<<"$out"
  case "$action" in
    run)
      by="${by//_/ }"
      if [ "$trigger" = auto ]; then
        ANYSSH_TRIGGER=auto ANYSSH_UPDATE_NOTE="inside the maintenance window" update_app update-if-newer
      else
        ANYSSH_TRIGGER=manual ANYSSH_UPDATE_NOTE="requested in the app by $by" update_app update
      fi
      ;;
    check-auto)
      local old_id new_id
      old_id="$(image_id)"
      dc pull --quiet app 2>/dev/null || return 0
      new_id="$(docker image inspect -f '{{.Id}}' "$(app_image)" 2>/dev/null || true)"
      if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ]; then
        say "A newer version is available; warning users, then updating"
        dc exec -T app node dist/cli/update-poll.js schedule-auto >/dev/null 2>&1 || true
      fi
      ;;
  esac
}

auto_update() {
  case "$1" in
    on)
      agent_install
      set_env_flag ANYSSH_AUTO_UPDATE true
      dc up -d
      say "Automatic updates are on. They run inside the maintenance window set in Settings (once a day if none is set), with a backup first, a warning to connected users and a rollback if the new version doesn't start"
      ;;
    off)
      [ "$(env_flag ANYSSH_WEB_UPDATE)" = true ] || agent_remove
      set_env_flag ANYSSH_AUTO_UPDATE ""
      dc up -d
      say "Automatic updates are off"
      ;;
    status)
      if [ "$(env_flag ANYSSH_AUTO_UPDATE)" = true ]; then say "Automatic updates are on"; else say "Automatic updates are off (turn on with: sudo any-ssh auto-update on)"; fi
      systemctl list-timers any-ssh-update.timer --no-pager 2>/dev/null | sed -n 1,2p || true
      ;;
    *) usage >&2; exit 1 ;;
  esac
}

web_update() {
  case "$1" in
    on)
      agent_install
      set_env_flag ANYSSH_WEB_UPDATE true
      say "Admins can now press \"Update now\" in Settings. The update agent looks for requests every 5 minutes"
      ;;
    off)
      [ "$(env_flag ANYSSH_AUTO_UPDATE)" = true ] || agent_remove
      set_env_flag ANYSSH_WEB_UPDATE ""
      say "\"Update now\" is off"
      ;;
    status)
      if [ "$(env_flag ANYSSH_WEB_UPDATE)" = true ]; then say "\"Update now\" is on"; else say "\"Update now\" is off (turn on with: sudo any-ssh web-update on)"; fi
      ;;
    *) usage >&2; exit 1 ;;
  esac
}

# fetch <path in repo> <destination> [image]: from ANYSSH_SOURCE when set, otherwise out of the image's /app/deploy.
fetch() {
  if [ -n "${ANYSSH_SOURCE:-}" ] || [ -z "${3:-}" ]; then
    curl -fsSL --proto '=https,file' "$SOURCE/$1" -o "$2"
  else
    docker run --rm --pull never --network none --entrypoint cat "$3" "/app/deploy/$(basename "$1")" >"$2" 2>/dev/null ||
      die "This image doesn't include its deployment files yet. Try again after the next release, or set ANYSSH_SOURCE."
  fi
}

case "${1:-help}" in
  start)
    need_root start
    dc up -d --pull missing
    wait_healthy
    say "Running"
    ;;
  stop) need_root stop; dc stop ;;
  restart)
    need_root restart
    dc up -d
    dc restart
    wait_healthy
    say "Restarted"
    ;;
  update | update-if-newer)
    need_root update
    update_app "$1"
    ;;
  auto-update) need_root auto-update; auto_update "${2:-status}" ;;
  web-update) need_root web-update; web_update "${2:-status}" ;;
  update-poll) need_root update-poll; update_poll ;;
  update-log) [ -r "$DIR/update.log" ] && tail -n 50 "$DIR/update.log" || echo "No updates recorded yet." ;;
  backup) need_root backup; backup "${2:-}" ;;
  backup-key) dc run --rm --no-deps -T app node dist/cli/backup.js keygen ;;
  verify-backup)
    if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then die "Usage: any-ssh verify-backup <backup file> <secret key file>"; fi
    backup_tool "$2" "$3" --verify-only
    ;;
  restore) need_root restore; restore_backup "${2:-}" "${3:-}" ;;
  status) dc ps ;;
  doctor) doctor ;;
  check-dns) check_dns "${2:-$(domain)}" ;;
  wait-cert)
    # Used by the installer: wait for the first certificate, then report.
    for _ in $(seq 1 "${2:-45}"); do cert_ok "$(domain)" && exit 0; sleep 2; done
    exit 1
    ;;
  logs) dc logs -f --tail 100 ;;
  config)
    need_root config
    "${EDITOR:-nano}" "$DIR/.env"
    chmod 600 "$DIR/.env"
    dc up -d
    wait_healthy
    say "Settings applied"
    ;;
  setup-token)
    needed="$(dc exec -T app node -e "fetch('http://127.0.0.1:8080/api/setup').then(r=>r.json()).then(j=>console.log(j.needed))" 2>/dev/null || true)"
    [ "$needed" = true ] || die "Setup is already done (or Any-SSH isn't running). Sign in with an admin account."
    token="$(dc logs --no-log-prefix app 2>/dev/null | sed -n 's/^.*Setup token: *\([^ ]*\).*$/\1/p' | tail -n 1)"
    [ -n "$token" ] || die "No setup token in the logs. It is only shown while no admin exists; restart to print a new one."
    echo "$token"
    ;;
  version)
    id="$(dc ps -q app 2>/dev/null || true)"
    [ -n "$id" ] || die "Not running."
    docker inspect -f '{{.Config.Image}}  version {{or (index .Config.Labels "org.opencontainers.image.version") "unknown"}}, commit {{or (index .Config.Labels "org.opencontainers.image.revision") "unknown"}}, built {{or (index .Config.Labels "org.opencontainers.image.created") "unknown"}}' "$id"
    ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
