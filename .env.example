# Required: 32 random bytes, base64. Generate with `npm run gen-key` (in server/).
# Keep it out of the repo; losing it makes stored SSH keys, passwords and 2FA seeds unreadable.
ANYSSH_MASTER_KEY=
# Or point at a file containing the key instead:
# ANYSSH_MASTER_KEY_FILE=/run/secrets/anyssh_master_key

# Docker Compose only: the domain Caddy gets a certificate for (DNS must point at this host),
# an optional email for Let's Encrypt notices, and the image tag to run (latest, or a release like 1.2).
ANYSSH_DOMAIN=ssh.example.com
# ANYSSH_ACME_EMAIL=you@example.com
# ANYSSH_VERSION=latest
# Admins see an "update available" notice by asking ghcr.io for the newest image. Set false to never phone home.
# ANYSSH_UPDATE_CHECK=true

# Public URL(s) people open in the browser (comma-separated). Used for Origin/CSRF checks.
ANYSSH_ORIGIN=https://ssh.example.com

ANYSSH_HOST=127.0.0.1
ANYSSH_PORT=8080
ANYSSH_DATA_DIR=./data

# Production behind a TLS-terminating reverse proxy:
NODE_ENV=production
ANYSSH_COOKIE_SECURE=true
ANYSSH_TRUST_PROXY=true

# Email (invites, password resets, security notices). Without SMTP, emails go to the server log.
# ANYSSH_SMTP_HOST=smtp.example.com
# ANYSSH_SMTP_PORT=587            # 465 = implicit TLS; anything else requires STARTTLS
# ANYSSH_SMTP_USER=any-ssh@example.com
# ANYSSH_SMTP_PASS=               # or ANYSSH_SMTP_PASS_FILE=/run/secrets/smtp_pass
# ANYSSH_MAIL_FROM="Any-SSH <any-ssh@example.com>"
# ANYSSH_PUBLIC_URL=https://ssh.example.com   # base for links in emails; defaults to the first ANYSSH_ORIGIN

# Master key rotation: set the new key above, list old ones here, run `npm run rotate-keys`, then remove.
# ANYSSH_PREVIOUS_MASTER_KEYS=

# Optional tuning
# ANYSSH_SESSION_IDLE_MINUTES=30
# ANYSSH_SESSION_MAX_HOURS=12
# ANYSSH_MAX_TERMINALS_PER_USER=8
# ANYSSH_ALLOW_LOOPBACK_TARGETS=false
